{
  "manifest_version": 3,
  "name": "DeloCN: 1688, Taobao в рублях и расчёт карго",
  "short_name": "DeloCN Helper",
  "version": "1.2.0",
  "description": "Автоперевод цен 1688, Taobao и Poizon из юаней (¥) в рубли (₽) по курсу выкупа и калькулятор доставки из Китая по 16 спецлиниям.",
  "author": "DeloCN — Логистика, выкуп и платежи в Китае (https://delocn.com)",
  "homepage_url": "https://delocn.com/browser-extension/",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "DeloCN: Курс юаня (₽) и калькулятор доставки из Китая (16 линий)",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.1688.com/*",
    "*://*.taobao.com/*",
    "*://*.tmall.com/*",
    "*://*.dewu.com/*",
    "*://*.poizon.com/*",
    "https://delocn.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.1688.com/*",
        "*://*.taobao.com/*",
        "*://*.tmall.com/*",
        "*://*.dewu.com/*",
        "*://*.poizon.com/*"
      ],
      "css": [
        "content.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "minimum_chrome_version": "105"
}